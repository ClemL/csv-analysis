{
  "name": "csv-analysis",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.mjs",
  "description": "Parse, profile and understand delimited data, entirely on your machine.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "desktop:build": "next build",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:build && electron-builder",
    "desktop:dist:win": "npm run desktop:build && electron-builder --win"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
